{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "CheapSeek — Workflow & Lifecycle",
    "locale": "en",
    "output": "cheapseek-workflow.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "runtime",
      "label": "macOS Runtime"
    },
    {
      "id": "app",
      "label": "App Flow"
    },
    {
      "id": "state",
      "label": "Persistence & Language"
    }
  ],
  "phases": [
    {
      "id": "launch",
      "label": "Launch",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "evaluate",
      "label": "Evaluate",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "present",
      "label": "Present",
      "fromCol": 4,
      "toCol": 4
    },
    {
      "id": "interact",
      "label": "Interact",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "tick-loop",
      "label": "Clock tick loop",
      "lane": "app",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "settings-flow",
      "label": "Settings & language",
      "lane": "state",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "login",
    "boot",
    "config",
    "evaluate",
    "render",
    "settings"
  ],
  "nodes": [
    {
      "id": "login",
      "lane": "runtime",
      "col": 0,
      "width": 100,
      "type": "external",
      "label": "Launch",
      "sublabel": "session / startup"
    },
    {
      "id": "boot",
      "lane": "app",
      "col": 0,
      "width": 100,
      "type": "frontend",
      "label": "CheapSeekApp",
      "sublabel": "@main MenuBarExtra"
    },
    {
      "id": "config",
      "lane": "app",
      "col": 1,
      "width": 100,
      "type": "backend",
      "label": "DeepSeekConfig",
      "sublabel": "bundled config",
      "tag": "Configuration.plist"
    },
    {
      "id": "clock",
      "lane": "app",
      "col": 2,
      "width": 100,
      "type": "backend",
      "label": "Clock",
      "sublabel": "async ticker",
      "tag": "no Timer"
    },
    {
      "id": "evaluate",
      "lane": "app",
      "col": 3,
      "width": 100,
      "type": "backend",
      "label": "PeakCalculator",
      "sublabel": "isPeak · schedule",
      "tag": "UTC"
    },
    {
      "id": "render",
      "lane": "app",
      "col": 4,
      "width": 100,
      "type": "frontend",
      "label": "Menu Bar",
      "sublabel": "text + symbol"
    },
    {
      "id": "settings",
      "lane": "app",
      "col": 5,
      "width": 100,
      "type": "frontend",
      "label": "Settings",
      "sublabel": "language · timezone"
    },
    {
      "id": "persist",
      "lane": "state",
      "col": 4,
      "width": 100,
      "type": "database",
      "label": "UserDefaults",
      "sublabel": "preferences"
    },
    {
      "id": "language",
      "lane": "state",
      "col": 5,
      "width": 100,
      "type": "messagebus",
      "label": "Localize-Swift",
      "sublabel": "language change"
    },
    {
      "id": "loginitem",
      "lane": "runtime",
      "col": 5,
      "width": 100,
      "type": "external",
      "label": "SMAppService",
      "sublabel": "launch at login"
    }
  ],
  "edges": [
    {
      "id": "login-boot",
      "from": "login",
      "to": "boot",
      "label": "open",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "boot-config",
      "from": "boot",
      "to": "config",
      "label": "loads config",
      "role": "main"
    },
    {
      "id": "config-evaluate",
      "from": "config",
      "to": "evaluate",
      "label": "schedule · prices",
      "role": "main"
    },
    {
      "id": "clock-evaluate",
      "from": "clock",
      "to": "evaluate",
      "label": "ticks",
      "role": "async"
    },
    {
      "id": "evaluate-render",
      "from": "evaluate",
      "to": "render",
      "label": "isPeak",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "render-settings",
      "from": "render",
      "to": "settings",
      "label": "tap",
      "role": "main"
    },
    {
      "id": "settings-persist",
      "from": "settings",
      "to": "persist",
      "label": "save",
      "role": "main"
    },
    {
      "id": "settings-loginitem",
      "from": "settings",
      "to": "loginitem",
      "label": "register",
      "role": "branch"
    },
    {
      "id": "settings-language",
      "from": "settings",
      "to": "language",
      "label": "setCurrentLanguage",
      "role": "branch"
    },
    {
      "id": "language-render",
      "from": "language",
      "to": "render",
      "label": "language change",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "loginitem-login",
      "from": "loginitem",
      "to": "login",
      "label": "next session",
      "role": "branch",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Launch & Loop",
      "items": [
        "Initial state is computed on launch",
        "The async clock refreshes on every interval"
      ]
    },
    {
      "dot": "emerald",
      "title": "Interaction",
      "items": [
        "The popup shows status and countdown",
        "Settings persist preferences"
      ]
    },
    {
      "dot": "violet",
      "title": "Lifecycle",
      "items": [
        "Language change refreshes views",
        "Launch at login via SMAppService"
      ]
    }
  ]
}