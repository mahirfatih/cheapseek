// CheapSeek base build configuration (shared, committed).
//
// Machine-local signing overrides (Apple team id) live in Config/Local.xcconfig,
// which is gitignored. Create it from the example:
//   cp Config/Local.xcconfig.example Config/Local.xcconfig
//   # then set DEVELOPMENT_TEAM (and optionally CODE_SIGN_IDENTITY)
//
// Never set signing in Xcode — the project is generated by XcodeGen and such
// changes are lost on the next `xcodegen generate`.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

// Required for Developer ID notarization.
ENABLE_HARDENED_RUNTIME = YES

// Include local overrides last so they win.
#include? "Local.xcconfig"
